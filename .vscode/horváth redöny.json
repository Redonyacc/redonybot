// --------------------------------------------------
// ÁRKALKULÁCIÓ
// --------------------------------------------------

app.post('/calculate', (req, res) => {
  try {
    const {
      product,
      width,
      height,
      depth,
      db,
      motor,
      controller,
      gross
    } = req.body;

    const selectedProduct = products[product];

    if (!selectedProduct) {
      return res.status(400).json({
        error: 'Ismeretlen termék'
      });
    }

    let result = 0;
    let unitData = 0;

    // M2
    if (selectedProduct.type === 'm2') {
      if (!width || !height) {
        return res.status(400).json({
          error: 'Hiányzó szélesség vagy magasság'
        });
      }

      const calc = calculateM2(
        Number(width),
        Number(height),
        selectedProduct.price
      );

      result += calc.total;
      unitData = calc.unit;
    }

    // FM
    if (selectedProduct.type === 'fm') {
      if (!width || !height || !depth) {
        return res.status(400).json({
          error: 'Hiányzó méretek'
        });
      }

      const calc = calculateFM(
        Number(width),
        Number(height),
        Number(depth),
        selectedProduct.price
      );

      result += calc.total;
      unitData = calc.unit;
    }

    // DB
    if (selectedProduct.type === 'db') {
      const calc = calculateDB(Number(db || 1), selectedProduct.price);

      result += calc.total;
      unitData = calc.unit;
    }

    // MOTOR
    if (motor && motors[motor]) {
      result += motors[motor].price;
    }

    // VEZÉRLÉS
    if (controller && controllers[controller]) {
      result += controllers[controller].price;
    }

    const net = result;
    const vat = Math.round(result * VAT);
    const grossPrice = Math.round(result * (1 + VAT));

    res.json({
      product: selectedProduct.name,

      unit_type: selectedProduct.type,
      unit_value: unitData,

      net_price: formatPrice(net),
      vat_price: formatPrice(vat),
      gross_price: formatPrice(grossPrice),

      selected_motor: motor ? motors[motor]?.name : null,
      selected_controller: controller
        ? controllers[controller]?.name
        : null,

      final_price: gross
        ? formatPrice(grossPrice)
        : formatPrice(net)
    });
  } catch (error) {
    console.error(error);

    res.status(500).json({
      error: 'Szerver hiba'
    });
  }
});

